<TestAction guiclass="TestActionGui" testclass="TestAction" testname="Pick user, products and scenario">
<intProp name="ActionProcessor.action">1</intProp>
<intProp name="ActionProcessor.target">0</intProp>
<stringProp name="ActionProcessor.duration">0</stringProp>
</TestAction>
<hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pick user, products and scenario">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Runs once per iteration, before any request.
// - gives every thread (across all thread groups) its own seeded user, so carts are not shared
// - spreads products deterministically over (thread, iteration): reruns send the same requests
// - picks the scenario of this iteration from the BROWSE_PCT / DETAIL_PCT mix (rest = order)
// No JDK class (Math, Random...) is referenced: the Groovy engine bundled with JMeter 5.6.3
// cannot resolve them when JMeter runs on Java 25.
def users = props.get('seed.userIds')
def products = props.get('seed.productIds')
if (vars.get('globalThread') == null) {
    int g
    synchronized (props) {
        def c = props.get('microservices.threadCounter')
        g = (c == null) ? 0 : (c as int)
        props.put('microservices.threadCounter', g + 1)
    }
    vars.put('globalThread', g.toString())
}
long t = Long.parseLong(vars.get('globalThread'))
long it = vars.getIteration()
long n = products.size()
vars.put('userId', users[(int) (t % users.size())])
vars.put('productId', products[(int) (((t * 7919L + it * 104729L) % n + n) % n)])
vars.put('productId2', products[(int) (((t * 15485863L + it * 32452843L + 1L) % n + n) % n)])
int r = (int) ((t * 31L + it * 17L) % 100L) + 1        // 1..100, cycles through every value
int browse = Integer.parseInt(vars.get('BROWSE_PCT'))
int detail = Integer.parseInt(vars.get('DETAIL_PCT'))
vars.put('scenario', r &lt;= browse ? 'browse' : (r &lt;= browse + detail ? 'detail' : 'order'))
</stringProp>
</JSR223PreProcessor>
<hashTree></hashTree>
</hashTree>
<IfController guiclass="IfControllerPanel" testclass="IfController" testname="Browse (BROWSE_PCT % of iterations)">
<stringProp name="IfController.condition">${__jexl3("${scenario}" == "browse")}</stringProp>
<boolProp name="IfController.evaluateAll">false</boolProp>
<boolProp name="IfController.useExpression">true</boolProp>
</IfController>
