<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="setup check server">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Fails fast (and stops the test) when a service address is missing.
def missing = ['USER', 'PRODUCT', 'ORDER'].findAll { def v = vars.get(it + '_HOST'); v == null || v.trim().isEmpty() }
if (!missing.isEmpty()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('NO_SERVER')
    SampleResult.setResponseMessage('No server set: run with -Jhost=&lt;server address&gt; (one address for all three services), or set -Juser_host / -Jproduct_host / -Jorder_host separately')
} else {
    def p = vars.get('PROTOCOL')
    def t = "user ${p}://${vars.get('USER_HOST')}:${vars.get('USER_PORT')}, product ${p}://${vars.get('PRODUCT_HOST')}:${vars.get('PRODUCT_PORT')}, order ${p}://${vars.get('ORDER_HOST')}:${vars.get('ORDER_PORT')}"
    SampleResult.setResponseMessage("run_id: ${vars.get('RUN_ID')}  targets: ${t}")
    log.info("[run] run_id=${vars.get('RUN_ID')} targets: ${t}")
}
</stringProp>
</JSR223Sampler>
<hashTree></hashTree>
<TestAction guiclass="TestActionGui" testclass="TestAction" testname="Split seeding between setUp threads">
<intProp name="ActionProcessor.action">1</intProp>
<intProp name="ActionProcessor.target">0</intProp>
<stringProp name="ActionProcessor.duration">0</stringProp>
</TestAction>
<hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Split seeding between setUp threads">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Splits the seeding work between the setUp threads, so seeding over a slow link stays short.
int t = ctx.getThreadNum()
int n = ctx.getThreadGroup().getNumThreads()
int u = Integer.parseInt(vars.get('SEED_USERS'))
int p = Integer.parseInt(vars.get('SEED_PRODUCTS'))
vars.put('myUsers', ((int) (u / n) + (t &lt; u % n ? 1 : 0)).toString())
vars.put('myProducts', ((int) (p / n) + (t &lt; p % n ? 1 : 0)).toString())
</stringProp>
</JSR223PreProcessor>
