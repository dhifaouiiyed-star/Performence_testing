<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Microservices - load test (ramp to failure)">
<stringProp name="TestPlan.comments">Linear ramp: users are added continuously from 0 to USERS over RAMP_UP seconds (default 0 -&gt; 1500 users over the whole 5 minutes). Shows how latency and errors grow with load and the moment the server starts refusing requests (the breaking point).</stringProp>
<boolProp name="TestPlan.functional_mode">false</boolProp>
<boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
<boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
<elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables"><collectionProp name="Arguments.arguments"/></elementProp>
</TestPlan>
<hashTree><Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Server and test settings (override with -J on the command line)">
<stringProp name="TestPlan.comments">HOST is empty on purpose: pass -Jhost=&lt;server address&gt; on the command line (one address for the three services, or -Juser_host / -Jproduct_host / -Jorder_host), or type it here in the GUI.</stringProp>
<collectionProp name="Arguments.arguments"><elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(host,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="USER_HOST" elementType="Argument"><stringProp name="Argument.name">USER_HOST</stringProp><stringProp name="Argument.value">${__P(user_host,${HOST})}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="USER_PORT" elementType="Argument"><stringProp name="Argument.name">USER_PORT</stringProp><stringProp name="Argument.value">${__P(user_port,8081)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PRODUCT_HOST" elementType="Argument"><stringProp name="Argument.name">PRODUCT_HOST</stringProp><stringProp name="Argument.value">${__P(product_host,${HOST})}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PRODUCT_PORT" elementType="Argument"><stringProp name="Argument.name">PRODUCT_PORT</stringProp><stringProp name="Argument.value">${__P(product_port,8082)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="ORDER_HOST" elementType="Argument"><stringProp name="Argument.name">ORDER_HOST</stringProp><stringProp name="Argument.value">${__P(order_host,${HOST})}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="ORDER_PORT" elementType="Argument"><stringProp name="Argument.name">ORDER_PORT</stringProp><stringProp name="Argument.value">${__P(order_port,8083)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PROTOCOL" elementType="Argument"><stringProp name="Argument.name">PROTOCOL</stringProp><stringProp name="Argument.value">${__P(protocol,http)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="SEED_USERS" elementType="Argument"><stringProp name="Argument.name">SEED_USERS</stringProp><stringProp name="Argument.value">${__P(seed_users,1500)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="SEED_PRODUCTS" elementType="Argument"><stringProp name="Argument.name">SEED_PRODUCTS</stringProp><stringProp name="Argument.value">${__P(seed_products,50)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="SEED_THREADS" elementType="Argument"><stringProp name="Argument.name">SEED_THREADS</stringProp><stringProp name="Argument.value">${__P(seed_threads,20)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="THINK_MS" elementType="Argument"><stringProp name="Argument.name">THINK_MS</stringProp><stringProp name="Argument.value">${__P(think_time,100)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="RUN_ID" elementType="Argument"><stringProp name="Argument.name">RUN_ID</stringProp><stringProp name="Argument.value">${__P(run_id,microservices-${__time(yyyyMMdd-HHmmss,)})}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="BROWSE_PCT" elementType="Argument"><stringProp name="Argument.name">BROWSE_PCT</stringProp><stringProp name="Argument.value">${__P(browse_pct,65)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DETAIL_PCT" elementType="Argument"><stringProp name="Argument.name">DETAIL_PCT</stringProp><stringProp name="Argument.value">${__P(detail_pct,15)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PRODUCT_PAGES" elementType="Argument"><stringProp name="Argument.name">PRODUCT_PAGES</stringProp><stringProp name="Argument.value">${__P(product_pages,2)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="USERS" elementType="Argument"><stringProp name="Argument.name">USERS</stringProp><stringProp name="Argument.value">${__P(users,1500)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="RAMP_UP" elementType="Argument"><stringProp name="Argument.name">RAMP_UP</stringProp><stringProp name="Argument.value">${__P(ramp,300)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DURATION" elementType="Argument"><stringProp name="Argument.name">DURATION</stringProp><stringProp name="Argument.value">${__P(duration,300)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp>
