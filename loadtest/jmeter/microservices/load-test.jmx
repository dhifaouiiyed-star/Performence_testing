<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pick the next product page">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// A different product for every page a user opens; deterministic, so reruns send the same requests.
def products = props.get('seed.productIds')
long n = products.size()
long k = Long.parseLong(vars.get('pageCounter') ?: '0') + 1
vars.put('pageCounter', k.toString())
long t = Long.parseLong(vars.get('globalThread'))
vars.put('pageProductId', products[(int) (((t * 7919L + k * 104729L + 13L) % n + n) % n)])
</stringProp>
</JSR223PreProcessor>
