<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Collect product ids">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">import groovy.json.JsonSlurper
// keep only the rows created by this run (the last N ids returned by the list endpoint)
def wanted = Integer.parseInt(vars.get('SEED_PRODUCTS'))
def ids = new JsonSlurper().parseText(prev.getResponseDataAsString()).collect { it.id.toString() }
if (ids.size() &lt; wanted) {
    prev.setSuccessful(false)
    prev.setResponseMessage("seeding failed: expected ${wanted} products, found ${ids.size()}")
    return
}
def kept = ids.takeRight(wanted)
props.put('seed.productIds', kept)
log.info("[seed] ${kept.size()} products ready: ${kept.first()}..${kept.last()}")
</stringProp>
</JSR223PostProcessor>
